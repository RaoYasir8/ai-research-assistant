APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=research_assistant
POSTGRES_USER=research_user
POSTGRES_PASSWORD=research_password
DATABASE_URL=postgresql+psycopg://research_user:research_password@db:5432/research_assistant
REDIS_URL=redis://redis:6379/0
RESEARCH_QUEUE=research:runs
WORKER_GROUP=research-workers
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=180
SEARXNG_URL=http://searxng:8080
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_SOURCE_CHARS=5500
MAX_FETCH_BYTES=1200000
SOURCE_FETCH_TIMEOUT_SECONDS=12
SEARXNG_SECRET=replace-with-a-second-random-secret
NEXT_PUBLIC_APP_NAME=AI Research Assistant
BACKEND_INTERNAL_URL=http://backend:8000
